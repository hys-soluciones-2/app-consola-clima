{
  "name": "02-weather",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "bun check",
    "test": "bun test",
    "build:binary": "bun build --compile --outfile dist/weather src/index.ts",
    "build": "bun run test && bun run build:binary",
    "start": "bun run src/index.ts",
    "dev": "bun run src/index.ts --watch"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
